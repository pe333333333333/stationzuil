import tkinter as tk
import requests
import json
import psycopg2
from PIL import Image, ImageTk


def create_connection():
    """
    Maakt verbinding met de database en maakt de standaard tabellen aan, mits
    deze nog niet bestaan.

    :returns De database verbinding
    """
    conn = psycopg2.connect(
        dbname='Stationszuil',
        user='postgres',
        password='0000',
        host='localhost',
        port='5432'
    )
    return conn


def get_recent_reviews(station):
    """
    Haalt de 5 meest recente reviews van dit station uit de database.
    """
    with create_connection() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                SELECT review.bericht, review.naam 
                FROM review 
                INNER JOIN beoordeling ON review.id = beoordeling.review_id 
                WHERE beoordeling.goedgekeurd = true AND review.station = %s 
                ORDER BY beoordeling.datum DESC 
                LIMIT 5
            """, [station])
            return cur.fetchall()


def get_faciliteiten(station):
    """
    Haalt faciliteiten op voor het gegeven station.
    """
    with create_connection() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT ov_fiets, lift, toilet, park_and_ride FROM stations WHERE station=%s", [station])
            return cur.fetchone()


def get_weersvoorspelling(station):
    """
    Haalt de weersvoorspelling op van het gegeven station via de OpenWeatherMap API.
    """
    api_key = '1c228a939f41c2131559ca8ea37f903d'  # Jouw API-sleutel
    response = requests.get(
        f'https://api.openweathermap.org/data/2.5/weather?q={station},nl&APPID={api_key}&units=metric')
    return response.json()


class Stationsscherm:
    def __init__(self, root):
        self.root = root
        self.root.title('Stationsinformatie')
        self.station = None
        self.init_ui()

    def init_ui(self):
        # Stationselectie
        self.label = tk.Label(self.root, text='Selecteer een station:')
        self.label.pack()

        self.station_var = tk.StringVar()
        self.station_menu = tk.OptionMenu(self.root, self.station_var, *self.get_stations(),
                                          command=self.update_station)
        self.station_menu.pack()

        self.info_button = tk.Button(self.root, text='Toon informatie', command=self.show_info)
        self.info_button.pack()

    def get_stations(self):
        with open('stations.txt', 'r') as file:
            return file.read().splitlines()

    def update_station(self, station):
        self.station = station

    def show_info(self):
        if not self.station:
            return

        reviews = get_recent_reviews(self.station)
        faciliteiten = get_faciliteiten(self.station)
        weersvoorspelling = get_weersvoorspelling(self.station)

        # Maak een nieuw venster voor de info
        info_window = tk.Toplevel(self.root)
        info_window.title(f'Informatie voor {self.station}')

        # Weer
        tk.Label(info_window, text=f"Weer: {weersvoorspelling['weather'][0]['description']}", font=('Arial', 14)).pack(
            pady=5)
        tk.Label(info_window, text=f"Temperatuur: {weersvoorspelling['main']['temp']} °C", font=('Arial', 14)).pack(
            pady=5)

        # Faciliteiten
        tk.Label(info_window, text='Beschikbare faciliteiten:', font=('Arial', 16, 'bold')).pack(pady=(10, 5))

        # Frame voor de faciliteiten
        faciliteiten_frame = tk.Frame(info_window)
        faciliteiten_frame.pack(pady=10)

        icon_names = ['OV-fiets', 'Lift', 'Toilet', 'P&R']
        icons = ['ov_fiets', 'lift', 'toilet', 'park_and_ride']

        for i in range(len(icons)):
            if faciliteiten[i]:  # Controleer of de faciliteit beschikbaar is
                icon_path = f'Icons/{icons[i]}.png'  # Pad naar de afbeelding
                try:
                    image = Image.open(icon_path).resize((64, 64), Image.LANCZOS)  # Grotere afbeeldingen
                    icon_image = ImageTk.PhotoImage(image)

                    # Label voor afbeelding
                    icon_label = tk.Label(faciliteiten_frame, image=icon_image)
                    icon_label.image = icon_image  # Bewaar referentie
                    icon_label.grid(row=0, column=i, padx=10)  # Gebruik grid voor uitlijning

                    # Label voor naam
                    tk.Label(faciliteiten_frame, text=icon_names[i], font=('Arial', 12)).grid(row=1, column=i, pady=(
                    5, 0))  # Label onder de afbeelding
                except Exception as e:
                    print(f"Fout bij het laden van de afbeelding {icon_path}: {e}")

        # Recent reviews
        tk.Label(info_window, text='Recente reviews:', font=('Arial', 16, 'bold')).pack(pady=(10, 5))
        for review in reviews:
            tk.Label(info_window, text=f"{review[0]} - {review[1]}", font=('Arial', 12)).pack()


if __name__ == "__main__":
    root = tk.Tk()
    app = Stationsscherm(root)
    root.mainloop()
